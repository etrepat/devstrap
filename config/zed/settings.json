{
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "buffer_font_family": "IosevkaTerm Nerd Font",
  "buffer_font_size": 16.0,
  "buffer_line_height": "comfortable",
  "ui_font_size": 15.0,
  "cursor_shape": "block",
  "tab_size": 4,
  "soft_tabs": true,
  "preferred_line_length": 120,
  "wrap_guides": [
    80,
    120
  ],
  "format_on_save": "off",
  "autosave": "off",
  "diff_view_style": "unified",
  "minimap": {
    "show": "auto"
  },
  "search": {
    "include_ignored": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "catppuccin": true
  }
}