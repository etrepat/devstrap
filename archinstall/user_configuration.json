{
  "app_config": {
    "audio_config": {
      "audio": "pipewire"
    },
    "bluetooth_config": {
      "enabled": true
    },
    "power_management_config": {
      "power_management": "power-profiles-daemon"
    },
    "print_service_config": {
      "enabled": true
    },
    "firewall_config": {
      "firewall": "ufw"
    },
    "fonts_config": {
      "fonts": [
        "noto-fonts",
        "noto-fonts-emoji",
        "noto-fonts-cjk",
        "ttf-liberation",
        "ttf-dejavu"
      ]
    }
  },
  "archinstall-language": "English",
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": false,
    "removable": true
  },
  "custom_commands": [
    "runuser -u etrepat -- git clone --depth 1 https://github.com/etrepat/devstrap.git /home/etrepat/devstrap",
    "install -d -o etrepat -g etrepat /home/etrepat/.config/autostart /home/etrepat/.config/devstrap /home/etrepat/.local/state/devstrap",
    "install -o etrepat -g etrepat -m 0755 /home/etrepat/devstrap/archinstall/first-boot.sh /home/etrepat/.config/devstrap/first-boot.sh",
    "runuser -u etrepat -- bash -c 'printf \"[Desktop Entry]\\nType=Application\\nName=DevStrap\\nComment=Bootstrap the development environment on first login\\nExec=/home/etrepat/.config/devstrap/first-boot.sh\\nTerminal=false\\nX-GNOME-Autostart-enabled=true\\n\" > /home/etrepat/.config/autostart/devstrap-first-boot.desktop'"
  ],
  "debug": false,
  "disk_config": {
    "config_type": "default_layout",
